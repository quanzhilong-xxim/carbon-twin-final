generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Identity {
  STUDENT
  BUSINESS
  CITY
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String              @unique
  passwordHash  String
  identity      Identity            @default(STUDENT)
  role          UserRole            @default(USER)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  profile       CarbonProfile?
  accounts      Account[]
  sessions      Session[]
  events        SimulationEvent[]
  messages      ChatMessage[]
  bookmarks     KnowledgeBookmark[]
}

model CarbonProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  identity              Identity  @default(STUDENT)
  regionCode            String    @default("CN")
  commuteMode           String    @default("PUBLIC_TRANSIT")
  commuteDistanceKm     Decimal   @default(0) @db.Decimal(10, 2)
  commuteDaysPerWeek    Int       @default(5)
  electricityKwhMonthly Decimal   @default(0) @db.Decimal(10, 2)
  beefMealsPerWeek      Int       @default(0)
  foodPattern           String    @default("MIXED")
  annualKgCo2e          Decimal   @default(0) @db.Decimal(12, 2)
  baselineKgCo2e        Decimal   @default(0) @db.Decimal(12, 2)
  projection2050KgCo2e  Decimal   @default(0) @db.Decimal(14, 2)
  lastCalculatedAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identity])
  @@index([updatedAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SimulationEvent {
  id                    String   @id @default(cuid())
  userId                String
  commuteMode           String
  commuteDistanceKm     Decimal  @db.Decimal(10, 2)
  commuteDaysPerWeek    Int
  electricityKwhMonthly Decimal  @db.Decimal(10, 2)
  beefMealsPerWeek      Int
  annualKgCo2e          Decimal  @db.Decimal(12, 2)
  projection2050KgCo2e  Decimal  @db.Decimal(14, 2)
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String   @db.Text
  identity  Identity
  citations Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model KnowledgeBookmark {
  id          String   @id @default(cuid())
  userId      String
  knowledgeId String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, knowledgeId])
  @@index([userId])
}
